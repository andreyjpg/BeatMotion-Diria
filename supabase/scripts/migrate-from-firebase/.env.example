# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Firebase (source) -------------------------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# Firebase console > Authentication > Users > (⋮ menu above the table) > Password hash parameters
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=8
FIREBASE_HASH_MEM_COST=14

# --- Supabase (destination) --------------------------------------------------
# Dashboard > Project Settings > API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Only used by `npm run check-login`
SUPABASE_PUBLISHABLE_KEY=

# Dashboard > Connect > "Session pooler" connection string (works on IPv4 networks)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Optional: path to the database CA certificate (Project Settings > Database > SSL
# configuration) to verify the server certificate. Without it the connection is
# still encrypted but the certificate isn't checked.
SUPABASE_DB_CA_CERT=
