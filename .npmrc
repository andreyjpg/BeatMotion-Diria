# @react-native-community/datetimepicker lists react-native-windows as an optional
# peer, and npm resolves its latest version even though this app doesn't use it.
# react-native-windows trails React Native releases, so its peer range never
# matches the Expo SDK's React Native version and npm refuses to install.
# Expo's `npx expo install` already keeps the real dependencies aligned.
legacy-peer-deps=true
